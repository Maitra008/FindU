# FindU Environment Configuration
# Copy this file to .env and fill in production values before deployment.
# NEVER commit a .env file containing real secrets to version control.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=missing_person
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# JWT Authentication
# REQUIRED: Replace with a cryptographically random string (min 32 characters)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE-ME-in-production-at-least-32-chars!!!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# Demo Operator Passwords (used only on first startup to seed demo accounts)
# REQUIRED: Replace with strong passwords in any non-development environment.
# These correspond to: admin, officer01, hospital01, ngo01 accounts.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=CHANGE-ME-admin-password
POLICE_PASSWORD=CHANGE-ME-police-password
HOSPITAL_PASSWORD=CHANGE-ME-hospital-password
NGO_PASSWORD=CHANGE-ME-ngo-password

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins (no wildcards)
# ---------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (for local dev; in Docker this is set via docker-compose environment)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
